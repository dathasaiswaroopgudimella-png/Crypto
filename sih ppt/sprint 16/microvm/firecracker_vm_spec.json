{
  "boot-source": {
    "kernel_image_path": "/boot/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodules rw quiet init=/sbin/init"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/chronis/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 256,
    "smt": false,
    "track_dirty_pages": false
  },
  "network-interfaces": [
    {
      "iface_id": "net1",
      "guest_mac": "AA:FC:00:00:00:01",
      "host_dev_name": "tap0"
    }
  ],
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/run/chronis/v.sock"
  },
  "logger": {
    "log_path": "/var/log/chronis/firecracker.log",
    "level": "Info",
    "show_level": true,
    "show_log_origin": false
  },
  "metrics": {
    "metrics_path": "/var/log/chronis/firecracker-metrics.log"
  }
}

# =================================================================
# AEGIS-TRACE VERCEL ENVIRONMENT VARIABLES TEMPLATE
# Copy these keys into your Vercel Project Settings > Environment Variables
# =================================================================

# --- Blockchain.com Gateway (BTC, ETH, SOL) ---
BLOCKCHAIN_COM_API_KEY=your_blockchain_com_api_key_here
BLOCKCHAIN_COM_GATEWAY_URL=https://api.blockchain.info/explorer-gateway-kt

# --- AI Intelligence & Forensic Summary Engine ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Supabase Database (Optional Historical Cache) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
